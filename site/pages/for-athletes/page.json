    {
      "id": "fa-faq",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 0
      },
      "children": [
        {
          "id": "fa-faq-row",
          "type": "row",
          "props": {
            "gap": 8,
            "align": "start",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "fa-faq-col",
              "type": "column",
              "props": {
                "span": 7
              },
              "children": [
                {
                  "id": "fa-faq-h",
                  "type": "heading",
                  "props": {
                    "text": "FAQ",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "fa-faq-items",
                  "type": "widget",
                  "props": {
                    "widget": "faq",
                    "config": {
                      "items": [
                        {
                          "q": "How do I earn money?",
                          "a": "You earn 25% of net revenue from your card sales. Net revenue means sales after production costs, shipping, taxes, and transaction fees. Payouts happen monthly through Stripe."
                        },
                        {
                          "q": "Do I still own my name and photos?",
                          "a": "Yes. You keep ownership of your name, image, and content. You’re granting PIP permission to use them to create, promote, and sell your trading cards."
                        },
                        {
                          "q": "What does “exclusive” mean?",
                          "a": "While this agreement is active, PIP is the only platform that can create and sell trading cards or digital collectibles (including NFTs) featuring you."
                        },
                        {
                          "q": "Can PIP make different versions of my card?",
                          "a": "Yes. PIP can create multiple editions or variants (such as standard, foil, limited, or champion series). All versions follow the same revenue split."
                        },
                        {
                          "q": "Do I need permission to use the photos I upload?",
                          "a": "Yes. You confirm that you own the rights to the photos or media you submit, or that you have permission from the photographer or rights holder to use them."
                        },
                        {
                          "q": "What if a photographer or event owns the photo rights?",
                          "a": "You should only upload photos you have permission to use. If you’re unsure, check with the photographer or event organizer before submitting."
                        },
                        {
                          "q": "Can I leave later?",
                          "a": "Yes. The agreement runs for 12 months and renews automatically, but either side can end it with 30 days’ notice. Any revenue you’ve earned will still be paid out."
                        }
                      ]
                    }
                  }
                }
              ]
            },
