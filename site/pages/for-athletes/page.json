                    "text": "Your card.\nYour story.",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "fa-lede",
                  "type": "text",
                  "props": {
                    "text": "Peace In Pressure creates official trading cards for freedivers. You earn 25% of net revenue from every card sold, paid monthly.",
