              "id": "fa-hero-quote",
              "type": "column",
              "props": {
                "span": 5
              },
              "children": [
                {
                  "id": "fa-quote",
                  "type": "testimonials",
                  "props": {
                    "headingLevel": 2,
                    "items": [
                      {
                        "quote": "PIP was created to help grow the sport of freediving and support the athletes who make it extraordinary. These cards are more than collectibles — they are a way to share your story, inspire others, and create new opportunities for you to earn directly from your achievements. My goal is that this project not only celebrates your journey but also helps fund your training, competitions, and travel, while bringing more visibility to the sport we all love.",
                        "name": "Jerry Van Galder",
                        "role": "Founder & Fellow Freediver"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
