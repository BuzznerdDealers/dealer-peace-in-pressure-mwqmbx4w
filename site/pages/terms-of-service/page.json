                },
                {
                  "id": "t-23",
                  "type": "text",
                  "props": {
                    "text": "We may update these terms from time to time. The version posted on this page applies to orders placed after it is published.",
                    "width": "full"
                  }
                },
                {
                  "id": "h-24",
                  "type": "heading",
                  "props": {
                    "text": "12. Governing law",
                    "headingLevel": 3
