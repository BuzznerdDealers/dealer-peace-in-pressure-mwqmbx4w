                },
                {
                  "id": "t-17",
                  "type": "text",
                  "props": {
                    "text": "All card designs, artwork, logos and site content are owned by PIP or its licensors, including the athletes featured. Buying a card gives you ownership of the physical item only, not the right to copy, reproduce or commercially use the designs or athlete likenesses.",
                    "width": "full"
