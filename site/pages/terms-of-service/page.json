                  }
                },
                {
                  "id": "t-3",
                  "type": "text",
                  "props": {
                    "text": "These Terms of Service govern your use of the Peace In Pressure website and your purchase of trading cards and related products from Peace In Pressure (“PIP”, “we”, “us”). By using the site or placing an order, you agree to these terms.",
