                },
                {
                  "id": "t-21",
                  "type": "text",
                  "props": {
                    "text": "To the extent permitted by law, PIP is not liable for indirect or consequential losses, and our total liability for any order is limited to the amount you paid for it.",
                    "width": "full"
                  }
                },
                {
                  "id": "h-22",
                  "type": "heading",
                  "props": {
                    "text": "11. Changes",
                    "headingLevel": 3
