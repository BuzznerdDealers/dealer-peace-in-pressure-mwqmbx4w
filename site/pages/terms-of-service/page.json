                },
                {
                  "id": "t-19",
                  "type": "text",
                  "props": {
                    "text": "You agree not to misuse the site, including by attempting to access accounts or data that are not yours, interfering with the site’s operation, or using automated tools to place orders.",
                    "width": "full"
                  }
                },
                {
                  "id": "h-20",
                  "type": "heading",
                  "props": {
                    "text": "10. Limitation of liability",
                    "headingLevel": 3
