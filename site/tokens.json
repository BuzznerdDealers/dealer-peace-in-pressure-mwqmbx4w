{
  "$schema": "./tokens.schema.json",
  "version": 2,
  "fonts": {
    "heading": "Yacote",
    "body": "Work Sans",
    "files": [
      { "family": "Yacote", "url": "/fonts/Yacote.ttf", "weight": "100 900", "style": "normal" },
      { "family": "Work Sans", "url": "/fonts/WorkSans.ttf", "weight": "100 900", "style": "normal" }
    ]
  },
  "colors": {
    "accent": "#00cdfd",
    "accentDark": "#00fbff",
    "ink": "#eaf2f8",
    "inkDark": "#020617",
    "muted": "#9fb4c6",
    "line": "#17314a",
    "card": "#041c30",
    "paper": "#020617"
  },
  "status": {
    "ok": "#00fbff",
    "info": "#00cdfd",
    "warn": "#ffc46b",
    "bad": "#ff7aa8"
  },
  "type": {
    "h1": 96,
    "h2": 56,
    "h3": 26,
    "body": 17,
    "small": 15,
    "eyebrow": 13
  },
  "typography": {
    "headingWeight": 700,
    "bodyWeight": 300,
    "headingLineHeight": 0.95,
    "bodyLineHeight": 1.6
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "radius": { "nav": 4, "input": 6, "card": 14, "modal": 20, "chip": 4 },
  "layout": { "container": "1180px", "padDesktop": 40, "padTablet": 32, "padMobile": 20 }
}
