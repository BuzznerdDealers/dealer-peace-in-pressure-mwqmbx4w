{
  "version": 1,
  "id": "athlete-dashboard-app",
  "label": "Athlete dashboard (sample data)",
  "description": "A faithful copy of the handoff screen (own header, no site chrome). Behaviour lives in the page script; data shown is sample content.",
  "category": "section",
  "origin": "user",
  "props": [],
  "html": "<div style=\"position: relative; width: 100%; min-height: 100vh; background: radial-gradient(120% 40% at 50% -10%, #0a2c46 0%, #041c30 40%, #020617 100%);\">\n  <div role=\"banner\" style=\"position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 40px; backdrop-filter: blur(14px); background: rgba(2,6,23,0.85); border-bottom: 1px solid rgba(255,255,255,0.07);\">\n    <a href=\"/\" style=\"display: flex; align-items: center;\"><img src=\"/logo-landscape.png\" alt=\"Peace In Pressure\" style=\"height: 34px; width: auto; display: block;\"></a>\n    <div style=\"display: flex; align-items: center; gap: 22px; font-size: 14px; color: #c4d4e2;\">\n      <a href=\"/athletes/enchante-gallardo\" style=\"text-decoration: none;\">View my public page</a>\n      <span style=\"width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #4a1a8a, #0a5a86); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 13px; color: #fff;\">JR</span>\n    </div>\n  </div>\n\n  <div style=\"max-width: 1240px; margin: 0 auto; padding: 44px 40px 120px; display: flex; flex-wrap: wrap; gap: 48px; align-items: start;\">\n    <aside style=\"flex: 0 0 220px; display: flex; flex-direction: column; gap: 22px;\">\n      <div style=\"display: flex; flex-direction: column; gap: 6px;\">\n        <span style=\"font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: #00cdfd;\">Athlete</span>\n        <span style=\"font-family: 'Yacote'; font-weight: 700; font-size: 26px; text-transform: uppercase; color: #f4fbff; line-height: 1;\">Jordan Rivera</span>\n      </div>\n      <nav style=\"display: flex; flex-direction: column; gap: 2px;\">\n        \n          <button style=\"text-align: left; padding: 11px 14px; border-radius: 8px; border: 0; background: rgba(0,205,253,0.12); color: #f4fbff; font-family: 'Work Sans'; font-size: 15px; cursor: pointer;\" data-on=\"click:tabs.go\" data-bind-style=\"background:tabs.bg;color:tabs.fg\" data-index=\"0\"><span data-bind=\"tabs.label\" data-index=\"0\">Overview</span></button>\n        \n          <button style=\"text-align: left; padding: 11px 14px; border-radius: 8px; border: 0; background: transparent; color: #9fb4c6; font-family: 'Work Sans'; font-size: 15px; cursor: pointer;\" data-on=\"click:tabs.go\" data-bind-style=\"background:tabs.bg;color:tabs.fg\" data-index=\"1\"><span data-bind=\"tabs.label\" data-index=\"1\">Sales</span></button>\n        \n          <button style=\"text-align: left; padding: 11px 14px; border-radius: 8px; border: 0; background: transparent; color: #9fb4c6; font-family: 'Work Sans'; font-size: 15px; cursor: pointer;\" data-on=\"click:tabs.go\" data-bind-style=\"background:tabs.bg;color:tabs.fg\" data-index=\"2\"><span data-bind=\"tabs.label\" data-index=\"2\">Payouts</span></button>\n        \n          <button style=\"text-align: left; padding: 11px 14px; border-radius: 8px; border: 0; background: transparent; color: #9fb4c6; font-family: 'Work Sans'; font-size: 15px; cursor: pointer;\" data-on=\"click:tabs.go\" data-bind-style=\"background:tabs.bg;color:tabs.fg\" data-index=\"3\"><span data-bind=\"tabs.label\" data-index=\"3\">Achievements</span></button>\n        \n          <button style=\"text-align: left; padding: 11px 14px; border-radius: 8px; border: 0; background: transparent; color: #9fb4c6; font-family: 'Work Sans'; font-size: 15px; cursor: pointer;\" data-on=\"click:tabs.go\" data-bind-style=\"background:tabs.bg;color:tabs.fg\" data-index=\"4\"><span data-bind=\"tabs.label\" data-index=\"4\">Profile</span></button>\n        \n          <button style=\"text-align: left; padding: 11px 14px; border-radius: 8px; border: 0; background: transparent; color: #9fb4c6; font-family: 'Work Sans'; font-size: 15px; cursor: pointer;\" data-on=\"click:tabs.go\" data-bind-style=\"background:tabs.bg;color:tabs.fg\" data-index=\"5\"><span data-bind=\"tabs.label\" data-index=\"5\">Documents</span></button>\n        \n      </nav>\n      <span style=\"font-size: 12px; color: #6f8598;\">Sample data shown</span>\n    </aside>\n\n    <main style=\"flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 32px;\">\n      <!-- OVERVIEW -->\n      <section style=\"display: flex; flex-direction: column; gap: 32px;\" data-bind-style=\"display:v0\">\n        <h1 style=\"font-family: 'Yacote'; font-weight: 700; font-size: 44px; text-transform: uppercase; margin: 0; color: #f4fbff;\">Overview</h1>\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 14px;\">\n          <div style=\"padding: 24px; border-radius: 12px; background: rgba(4,28,48,0.7); border: 1px solid rgba(255,255,255,0.08); display: flex; flex-direction: column; gap: 8px;\"><span style=\"font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #8da2b5;\">Your share this month</span><span style=\"font-family: 'Yacote'; font-weight: 700; font-size: 36px; color: #00fbff;\">$412.50</span></div>\n          <div style=\"padding: 24px; border-radius: 12px; background: rgba(4,28,48,0.7); border: 1px solid rgba(255,255,255,0.08); display: flex; flex-direction: column; gap: 8px;\"><span style=\"font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #8da2b5;\">Next payout</span><span style=\"font-family: 'Yacote'; font-weight: 700; font-size: 36px; color: #f4fbff;\">Dec 1</span></div>\n          <div style=\"padding: 24px; border-radius: 12px; background: rgba(4,28,48,0.7); border: 1px solid rgba(255,255,255,0.08); display: flex; flex-direction: column; gap: 8px;\"><span style=\"font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #8da2b5;\">Cards sold, all time</span><span style=\"font-family: 'Yacote'; font-weight: 700; font-size: 36px; color: #f4fbff;\">138</span></div>\n        </div>\n        <div style=\"display: flex; flex-direction: column; gap: 14px;\">\n          <h2 style=\"margin: 0; font-size: 18px; font-weight: 600; color: #f4fbff;\">Account status</h2>\n          <ul style=\"list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border-top: 1px solid rgba(255,255,255,0.1);\">\n            \n              <li style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"font-size: 15px; color: #eaf2f8;\">Athlete Legal Bundle v2026.01.11</span><span style=\"font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #00fbff;\">Signed</span></li>\n            \n              <li style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"font-size: 15px; color: #eaf2f8;\">Tax form (W-8BEN, via Stripe)</span><span style=\"font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #00fbff;\">Approved</span></li>\n            \n              <li style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"font-size: 15px; color: #eaf2f8;\">Payout method</span><span style=\"font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #00fbff;\">Stripe connected</span></li>\n            \n              <li style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"font-size: 15px; color: #eaf2f8;\">Card art</span><span style=\"font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #ffc46b;\">Awaiting your review</span></li>\n            \n          </ul>\n        </div>\n      </section>\n\n      <!-- SALES -->\n      <section style=\"display: none; flex-direction: column; gap: 24px;\" data-bind-style=\"display:v1\">\n        <h1 style=\"font-family: 'Yacote'; font-weight: 700; font-size: 44px; text-transform: uppercase; margin: 0; color: #f4fbff;\">Sales</h1>\n        <p style=\"margin: 0; font-size: 14px; line-height: 1.6; color: #9fb4c6;\">Net revenue is gross sales minus production costs, shipping, taxes and transaction fees. Your share is 25% of net revenue.</p>\n        <div style=\"overflow-x: auto; border: 1px solid rgba(255,255,255,0.08); border-radius: 12px;\">\n          <table style=\"width: 100%; border-collapse: collapse; font-size: 15px; min-width: 560px;\">\n            <thead><tr style=\"background: rgba(4,28,48,0.8);\"><th style=\"text-align: left; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Month</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Cards</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Gross</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Net revenue</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Your 25%</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Report</th></tr></thead>\n            <tbody>\n              \n                <tr style=\"border-top: 1px solid rgba(255,255,255,0.07);\"><td style=\"padding: 14px 18px; color: #eaf2f8;\">November 2026</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">31</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$2,480.00</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$1,650.00</td><td style=\"padding: 14px 18px; text-align: right; color: #00fbff; font-weight: 600;\">$412.50</td><td style=\"padding: 14px 18px; text-align: right;\"><a href=\"#\" style=\"font-size: 13px;\">PDF</a></td></tr>\n              \n                <tr style=\"border-top: 1px solid rgba(255,255,255,0.07);\"><td style=\"padding: 14px 18px; color: #eaf2f8;\">October 2026</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">44</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$3,520.00</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$2,340.00</td><td style=\"padding: 14px 18px; text-align: right; color: #00fbff; font-weight: 600;\">$585.00</td><td style=\"padding: 14px 18px; text-align: right;\"><a href=\"#\" style=\"font-size: 13px;\">PDF</a></td></tr>\n              \n                <tr style=\"border-top: 1px solid rgba(255,255,255,0.07);\"><td style=\"padding: 14px 18px; color: #eaf2f8;\">September 2026</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">38</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$3,040.00</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$2,020.00</td><td style=\"padding: 14px 18px; text-align: right; color: #00fbff; font-weight: 600;\">$505.00</td><td style=\"padding: 14px 18px; text-align: right;\"><a href=\"#\" style=\"font-size: 13px;\">PDF</a></td></tr>\n              \n                <tr style=\"border-top: 1px solid rgba(255,255,255,0.07);\"><td style=\"padding: 14px 18px; color: #eaf2f8;\">August 2026</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">25</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$2,000.00</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$1,330.00</td><td style=\"padding: 14px 18px; text-align: right; color: #00fbff; font-weight: 600;\">$332.50</td><td style=\"padding: 14px 18px; text-align: right;\"><a href=\"#\" style=\"font-size: 13px;\">PDF</a></td></tr>\n              \n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- PAYOUTS -->\n      <section style=\"display: none; flex-direction: column; gap: 24px;\" data-bind-style=\"display:v2\">\n        <h1 style=\"font-family: 'Yacote'; font-weight: 700; font-size: 44px; text-transform: uppercase; margin: 0; color: #f4fbff;\">Payouts</h1>\n        <div style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; border-radius: 12px; background: rgba(4,28,48,0.7); border: 1px solid rgba(255,255,255,0.08);\">\n          <div style=\"display: flex; flex-direction: column; gap: 4px;\"><span style=\"font-size: 15px; color: #f4fbff; font-weight: 600;\">Stripe · USD</span><span style=\"font-size: 13px; color: #9fb4c6;\">Tax details collected by Stripe · Treaty rate 0%</span></div>\n          <a href=\"#\" style=\"font-size: 14px;\">Manage in Stripe</a>\n        </div>\n        <div style=\"overflow-x: auto; border: 1px solid rgba(255,255,255,0.08); border-radius: 12px;\">\n          <table style=\"width: 100%; border-collapse: collapse; font-size: 15px; min-width: 520px;\">\n            <thead><tr style=\"background: rgba(4,28,48,0.8);\"><th style=\"text-align: left; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Date</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Your share</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Withheld</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Paid</th><th style=\"text-align: right; padding: 14px 18px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8da2b5; font-weight: 500;\">Status</th></tr></thead>\n            <tbody>\n              \n                <tr style=\"border-top: 1px solid rgba(255,255,255,0.07);\"><td style=\"padding: 14px 18px; color: #eaf2f8;\">Dec 1, 2026</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$412.50</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$0.00</td><td style=\"padding: 14px 18px; text-align: right; color: #00fbff; font-weight: 600;\">$412.50</td><td style=\"padding: 14px 18px; text-align: right; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #ffc46b;\">Scheduled</td></tr>\n              \n                <tr style=\"border-top: 1px solid rgba(255,255,255,0.07);\"><td style=\"padding: 14px 18px; color: #eaf2f8;\">Nov 1, 2026</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$585.00</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$0.00</td><td style=\"padding: 14px 18px; text-align: right; color: #00fbff; font-weight: 600;\">$585.00</td><td style=\"padding: 14px 18px; text-align: right; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #00fbff;\">Paid</td></tr>\n              \n                <tr style=\"border-top: 1px solid rgba(255,255,255,0.07);\"><td style=\"padding: 14px 18px; color: #eaf2f8;\">Oct 1, 2026</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$505.00</td><td style=\"padding: 14px 18px; text-align: right; color: #c4d4e2;\">$0.00</td><td style=\"padding: 14px 18px; text-align: right; color: #00fbff; font-weight: 600;\">$505.00</td><td style=\"padding: 14px 18px; text-align: right; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #00fbff;\">Paid</td></tr>\n              \n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- ACHIEVEMENTS -->\n      <section style=\"display: none; flex-direction: column; gap: 28px;\" data-bind-style=\"display:v3\">\n        <div style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px;\">\n          <h1 style=\"font-family: 'Yacote'; font-weight: 700; font-size: 44px; text-transform: uppercase; margin: 0; color: #f4fbff;\">Achievements</h1>\n          <span style=\"font-size: 13px; color: #ffc46b;\">2026 Annual Series cut-off: Dec 31, 2026, 11:59 PM</span>\n        </div>\n        <p style=\"margin: 0; font-size: 14px; line-height: 1.6; color: #9fb4c6;\">Only results ratified by AIDA or CMAS qualify for badges. Federation names are not shown on cards. <a href=\"/medal-record-policy\" target=\"_blank\">Medal &amp; Record Policy</a></p>\n        <ul style=\"list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border-top: 1px solid rgba(255,255,255,0.1);\">\n          \n            <li style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"display: flex; flex-direction: column; gap: 4px;\"><span style=\"font-size: 15px; color: #eaf2f8;\">National Record · CWT 102 m</span><span style=\"font-size: 13px; color: #8da2b5;\">Performed Aug 14, 2026 · Ratified Sep 2, 2026</span></span><span style=\"font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #00fbff;\">Verified</span></li>\n          \n            <li style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"display: flex; flex-direction: column; gap: 4px;\"><span style=\"font-size: 15px; color: #eaf2f8;\">Championship podium · FIM</span><span style=\"font-size: 13px; color: #8da2b5;\">Performed Sep 21, 2026</span></span><span style=\"font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #ffc46b;\">In review</span></li>\n          \n        </ul>\n\n        <div data-fake-form style=\"display: flex; flex-direction: column; gap: 20px; padding: 28px; border-radius: 14px; background: rgba(4,28,48,0.55); border: 1px solid rgba(255,255,255,0.08);\" data-on=\"submit:submitAch\">\n          <h2 style=\"margin: 0; font-size: 20px; font-weight: 600; color: #f4fbff;\">Submit an achievement</h2>\n          <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 16px;\">\n            <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Badge type *\n              <select name=\"badge\" required style=\"height: 48px; padding: 0 14px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\"><option value=\"\">Select</option><option>World Record (WR)</option><option>Continental Record (CR)</option><option>National Record (NR)</option><option>Championship podium</option></select>\n            </label>\n            <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Discipline *\n              <select name=\"discipline\" required style=\"height: 48px; padding: 0 14px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\"><option value=\"\">Select</option><option>CWT</option><option>CWTB</option><option>CNF</option><option>FIM</option><option>VWT</option><option>NLT</option><option>STA</option><option>DYN</option><option>DYNB</option><option>DNF</option><option>Other</option></select>\n            </label>\n            <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Result (m or time) *<input name=\"result\" required placeholder=\"e.g. 102 m\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n            <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Date of performance *<input name=\"date\" type=\"date\" required style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none; color-scheme: dark;\" class=\"focus-wp4ty\"></label>\n            <label style=\"grid-column: 1 / -1; display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Competition / event *<input name=\"event\" required style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n            <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Ratified by *\n              <select name=\"fed\" required style=\"height: 48px; padding: 0 14px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\"><option value=\"\">Select</option><option>AIDA</option><option>CMAS</option><option>AIDA and CMAS</option><option>Pending ratification</option></select>\n            </label>\n            <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Ratification date<input name=\"ratDate\" type=\"date\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none; color-scheme: dark;\" class=\"focus-wp4ty\"></label>\n            <label style=\"grid-column: 1 / -1; display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Link to official result *<input name=\"url\" type=\"url\" required placeholder=\"https://\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n          </div>\n          <label style=\"display: flex; align-items: start; gap: 12px; font-size: 14px; line-height: 1.5; color: #c4d4e2; cursor: pointer;\"><input type=\"checkbox\" required style=\"accent-color: #00cdfd; width: 18px; height: 18px; margin: 2px 0 0; flex: none;\">This result was achieved in official, sanctioned competition and is accurate. *</label>\n          <div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 16px;\">\n            <button type=\"submit\" style=\"font-family: 'Yacote'; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; font-size: 14px; color: #020617; background: linear-gradient(135deg, #00fbff, #00cdfd); border: 0; padding: 14px 30px; border-radius: 4px; cursor: pointer;\">Submit for review</button>\n            <div data-if=\"achSent\" style=\"display: contents\" hidden><span style=\"font-size: 14px; color: #00fbff;\">Submitted. We’ll verify it before the cut-off.</span></div>\n          </div>\n        </div>\n      </section>\n\n      <!-- PROFILE -->\n      <section style=\"display: none; flex-direction: column; gap: 24px;\" data-bind-style=\"display:v4\">\n        <h1 style=\"font-family: 'Yacote'; font-weight: 700; font-size: 44px; text-transform: uppercase; margin: 0; color: #f4fbff;\">Profile</h1>\n        <div data-fake-form style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 18px;\" data-on=\"submit:saveProfile\">\n          <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Name on card<input value=\"Jordan Rivera\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n          <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Email<input type=\"email\" value=\"jordan@example.com\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n          <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Instagram<input value=\"@jordan.dives\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n          <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Federation profile<input type=\"url\" placeholder=\"https://\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n          <label style=\"grid-column: 1 / -1; display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Bio<textarea rows=\"4\" maxlength=\"600\" style=\"padding: 14px 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; line-height: 1.6; outline: none; resize: vertical;\" class=\"focus-wp4ty\"></textarea></label>\n          <p style=\"grid-column: 1 / -1; margin: 0; font-size: 13px; color: #8da2b5;\">Changes are reviewed before they appear on your public page. To replace photos, email info@peaceinpressure.com.</p>\n          <div style=\"grid-column: 1 / -1; display: flex; align-items: center; gap: 16px;\"><button type=\"submit\" style=\"font-family: 'Yacote'; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; font-size: 14px; color: #020617; background: linear-gradient(135deg, #00fbff, #00cdfd); border: 0; padding: 14px 30px; border-radius: 4px; cursor: pointer;\">Save changes</button><div data-if=\"profileSaved\" style=\"display: contents\" hidden><span style=\"font-size: 14px; color: #00fbff;\">Sent for review.</span></div></div>\n        </div>\n      </section>\n\n      <!-- DOCUMENTS -->\n      <section style=\"display: none; flex-direction: column; gap: 24px;\" data-bind-style=\"display:v5\">\n        <h1 style=\"font-family: 'Yacote'; font-weight: 700; font-size: 44px; text-transform: uppercase; margin: 0; color: #f4fbff;\">Documents</h1>\n        <ul style=\"list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border-top: 1px solid rgba(255,255,255,0.1);\">\n          \n            <li style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"display: flex; flex-direction: column; gap: 4px;\"><span style=\"font-size: 15px; color: #eaf2f8;\">Athlete Legal Bundle v2026.01.11</span><span style=\"font-size: 13px; color: #8da2b5;\">Signed Sep 28, 2026 · Jordan Rivera</span></span><a href=\"/athlete-legal-bundle\" style=\"font-size: 14px;\">View</a></li>\n          \n            <li style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"display: flex; flex-direction: column; gap: 4px;\"><span style=\"font-size: 15px; color: #eaf2f8;\">W-8BEN</span><span style=\"font-size: 13px; color: #8da2b5;\">Collected by Stripe · Sep 28, 2026</span></span><a href=\"#\" style=\"font-size: 14px;\">View in Stripe</a></li>\n          \n            <li style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,0.1);\"><span style=\"display: flex; flex-direction: column; gap: 4px;\"><span style=\"font-size: 15px; color: #eaf2f8;\">Tax &amp; Payout Overview</span><span style=\"font-size: 13px; color: #8da2b5;\">Reference</span></span><a href=\"/athlete-tax-payouts\" style=\"font-size: 14px;\">View</a></li>\n          \n        </ul>\n        <p style=\"margin: 0; font-size: 14px; line-height: 1.6; color: #9fb4c6;\">To end your agreement, give 30 days’ written notice to info@peaceinpressure.com. Revenue you’ve earned is paid within 60 days.</p>\n      </section>\n    </main>\n  </div>\n</div>",
