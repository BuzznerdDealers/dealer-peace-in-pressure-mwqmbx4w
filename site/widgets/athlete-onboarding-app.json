{
  "version": 1,
  "id": "athlete-onboarding-app",
  "label": "Athlete onboarding (private link)",
  "description": "A faithful copy of the handoff screen (own header, no site chrome). Behaviour lives in the page script; data shown is sample content.",
  "category": "section",
  "origin": "user",
  "props": [],
  "html": "<div style=\"position: relative; width: 100%; min-height: 100vh; background: radial-gradient(120% 40% at 50% -10%, #0a2c46 0%, #041c30 40%, #020617 100%);\">\n  <div role=\"banner\" style=\"position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 40px; backdrop-filter: blur(14px); background: rgba(2,6,23,0.85); border-bottom: 1px solid rgba(255,255,255,0.07);\">\n    <a href=\"/\" style=\"display: flex; align-items: center;\"><img src=\"/logo-landscape.png\" alt=\"Peace In Pressure\" style=\"height: 34px; width: auto; display: block;\"></a>\n    <span style=\"font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: #9fb4c6;\">Athlete onboarding · Private link</span>\n  </div>\n\n  <div style=\"max-width: 1366px; margin: 0 auto; padding: 56px 40px 120px; display: flex; flex-wrap: wrap; gap: 56px; align-items: start;\">\n    <aside style=\"flex: 0 0 260px; display: flex; flex-direction: column; gap: 28px;\">\n      <div style=\"display: flex; flex-direction: column; gap: 10px;\">\n        <span style=\"font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: #00cdfd;\">Welcome</span>\n        <h1 style=\"font-family: 'Yacote'; font-weight: 700; font-size: 40px; text-transform: uppercase; margin: 0; line-height: 0.95; color: #f4fbff;\">Jordan Rivera</h1>\n        <p style=\"margin: 0; font-size: 14px; line-height: 1.6; color: #9fb4c6;\">You’ve been approved. Complete these steps to launch your cards. Progress saves as you go.</p>\n      </div>\n      <ol style=\"list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px;\">\n        \n          <li><button style=\"width: 100%; display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 8px; border: 0; background: rgba(0,205,253,0.12); color: #f4fbff; font-family: 'Work Sans'; font-size: 15px; text-align: left; cursor: pointer;\" data-on=\"click:steps.go\" data-bind-style=\"background:steps.bg;color:steps.fg\" data-index=\"0\"><span style=\"width: 28px; height: 28px; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; background: #00fbff; color: #020617;\" data-bind-style=\"background:steps.dotBg;color:steps.dotFg\" data-index=\"0\"><span data-bind=\"steps.mark\" data-index=\"0\">1</span></span><span data-bind=\"steps.label\" data-index=\"0\">Profile &amp; photos</span></button></li>\n        \n          <li><button style=\"width: 100%; display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 8px; border: 0; background: transparent; color: #6f8598; font-family: 'Work Sans'; font-size: 15px; text-align: left; cursor: pointer;\" data-on=\"click:steps.go\" data-bind-style=\"background:steps.bg;color:steps.fg\" data-index=\"1\"><span style=\"width: 28px; height: 28px; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; background: rgba(255,255,255,0.08); color: #9fb4c6;\" data-bind-style=\"background:steps.dotBg;color:steps.dotFg\" data-index=\"1\"><span data-bind=\"steps.mark\" data-index=\"1\">2</span></span><span data-bind=\"steps.label\" data-index=\"1\">Legal agreement</span></button></li>\n        \n          <li><button style=\"width: 100%; display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 8px; border: 0; background: transparent; color: #6f8598; font-family: 'Work Sans'; font-size: 15px; text-align: left; cursor: pointer;\" data-on=\"click:steps.go\" data-bind-style=\"background:steps.bg;color:steps.fg\" data-index=\"2\"><span style=\"width: 28px; height: 28px; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; background: rgba(255,255,255,0.08); color: #9fb4c6;\" data-bind-style=\"background:steps.dotBg;color:steps.dotFg\" data-index=\"2\"><span data-bind=\"steps.mark\" data-index=\"2\">3</span></span><span data-bind=\"steps.label\" data-index=\"2\">Payouts &amp; tax</span></button></li>\n        \n          <li><button style=\"width: 100%; display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 8px; border: 0; background: transparent; color: #6f8598; font-family: 'Work Sans'; font-size: 15px; text-align: left; cursor: pointer;\" data-on=\"click:steps.go\" data-bind-style=\"background:steps.bg;color:steps.fg\" data-index=\"3\"><span style=\"width: 28px; height: 28px; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; background: rgba(255,255,255,0.08); color: #9fb4c6;\" data-bind-style=\"background:steps.dotBg;color:steps.dotFg\" data-index=\"3\"><span data-bind=\"steps.mark\" data-index=\"3\">4</span></span><span data-bind=\"steps.label\" data-index=\"3\">Review</span></button></li>\n        \n      </ol>\n    </aside>\n\n    <main style=\"flex: 1 1 520px; min-width: 0;\">\n      <!-- STEP 1 -->\n      <div data-fake-form style=\"display: flex; flex-direction: column; gap: 34px;\" data-on=\"submit:next\" data-bind-style=\"display:d1\">\n        <div style=\"display: flex; flex-direction: column; gap: 8px;\">\n          <span style=\"font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: #00cdfd;\">Step 1 of 4</span>\n          <h2 style=\"font-family: 'Yacote'; font-weight: 700; font-size: 36px; text-transform: uppercase; margin: 0; color: #f4fbff;\">Profile &amp; photos</h2>\n        </div>\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 18px;\">\n          <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Name on your card *<input name=\"displayName\" required value=\"Jordan Rivera\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n          <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Instagram<input name=\"instagram\" value=\"@jordan.dives\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n          <label style=\"grid-column: 1 / -1; display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Bio for your profile page *<textarea name=\"bio\" required maxlength=\"600\" rows=\"4\" style=\"padding: 14px 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; line-height: 1.6; outline: none; resize: vertical;\" class=\"focus-wp4ty\"></textarea></label>\n        </div>\n\n        <div style=\"display: flex; flex-direction: column; gap: 16px;\">\n          <h3 style=\"margin: 0; font-size: 18px; font-weight: 600; color: #f4fbff;\">Photos</h3>\n          <p style=\"margin: 0; font-size: 14px; line-height: 1.6; color: #9fb4c6;\">JPG or PNG, at least 2400 px on the long edge. Your back photo is used on your profile page; card photos are used for card art.</p>\n          <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 18px;\">\n            \n              <div style=\"display: flex; flex-direction: column; gap: 10px;\">\n                <label style=\"position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; aspect-ratio: 4 / 5; border-radius: 12px; border: 1px dashed rgba(255,255,255,0.25); background: rgba(4,28,48,0.55); cursor: pointer; padding: 16px; text-align: center;\" class=\"hover-1rnkq\">\n                  <input type=\"file\" accept=\"image/jpeg,image/png\" required style=\"position: absolute; inset: 0; opacity: 0; cursor: pointer;\" data-on=\"change:photos.onFile\" data-index=\"0\">\n                  <span style=\"font-size: 15px; font-weight: 600; color: #f4fbff;\"><span data-bind=\"photos.label\" data-index=\"0\">Back photo (profile)</span></span>\n                  <span style=\"font-size: 13px; color: #8da2b5; word-break: break-all;\" data-bind-style=\"color:photos.statusColor\" data-index=\"0\"><span data-bind=\"photos.status\" data-index=\"0\">Required · click to upload</span></span>\n                </label>\n                <input placeholder=\"Photographer credit\" aria-label=\"Back photo (profile) photographer credit\" style=\"height: 44px; padding: 0 14px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 14px; outline: none;\" class=\"focus-wp4ty\">\n              </div>\n            \n              <div style=\"display: flex; flex-direction: column; gap: 10px;\">\n                <label style=\"position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; aspect-ratio: 4 / 5; border-radius: 12px; border: 1px dashed rgba(255,255,255,0.25); background: rgba(4,28,48,0.55); cursor: pointer; padding: 16px; text-align: center;\" class=\"hover-1rnkq\">\n                  <input type=\"file\" accept=\"image/jpeg,image/png\" required style=\"position: absolute; inset: 0; opacity: 0; cursor: pointer;\" data-on=\"change:photos.onFile\" data-index=\"1\">\n                  <span style=\"font-size: 15px; font-weight: 600; color: #f4fbff;\"><span data-bind=\"photos.label\" data-index=\"1\">Card photo 1</span></span>\n                  <span style=\"font-size: 13px; color: #8da2b5; word-break: break-all;\" data-bind-style=\"color:photos.statusColor\" data-index=\"1\"><span data-bind=\"photos.status\" data-index=\"1\">Required · click to upload</span></span>\n                </label>\n                <input placeholder=\"Photographer credit\" aria-label=\"Card photo 1 photographer credit\" style=\"height: 44px; padding: 0 14px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 14px; outline: none;\" class=\"focus-wp4ty\">\n              </div>\n            \n              <div style=\"display: flex; flex-direction: column; gap: 10px;\">\n                <label style=\"position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; aspect-ratio: 4 / 5; border-radius: 12px; border: 1px dashed rgba(255,255,255,0.25); background: rgba(4,28,48,0.55); cursor: pointer; padding: 16px; text-align: center;\" class=\"hover-1rnkq\">\n                  <input type=\"file\" accept=\"image/jpeg,image/png\" style=\"position: absolute; inset: 0; opacity: 0; cursor: pointer;\" data-on=\"change:photos.onFile\" data-index=\"2\">\n                  <span style=\"font-size: 15px; font-weight: 600; color: #f4fbff;\"><span data-bind=\"photos.label\" data-index=\"2\">Card photo 2</span></span>\n                  <span style=\"font-size: 13px; color: #8da2b5; word-break: break-all;\" data-bind-style=\"color:photos.statusColor\" data-index=\"2\"><span data-bind=\"photos.status\" data-index=\"2\">Optional · click to upload</span></span>\n                </label>\n                <input placeholder=\"Photographer credit\" aria-label=\"Card photo 2 photographer credit\" style=\"height: 44px; padding: 0 14px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 14px; outline: none;\" class=\"focus-wp4ty\">\n              </div>\n            \n          </div>\n          <label style=\"display: flex; align-items: start; gap: 12px; font-size: 15px; line-height: 1.5; color: #c4d4e2; cursor: pointer;\"><input type=\"checkbox\" required style=\"accent-color: #00cdfd; width: 18px; height: 18px; margin: 2px 0 0; flex: none;\">I own these photos or have permission from the photographer or rights holder to use them. *</label>\n        </div>\n\n        <div style=\"display: flex; flex-direction: column; gap: 14px;\">\n          <h3 style=\"margin: 0; font-size: 18px; font-weight: 600; color: #f4fbff;\">Exclusivity</h3>\n          <p style=\"margin: 0; font-size: 15px; line-height: 1.6; color: #c4d4e2;\">Do you currently have an agreement with another provider for trading cards or digital collectibles (including NFTs) featuring you? *</p>\n          <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n            <label style=\"display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); font-size: 15px; color: #eaf2f8; cursor: pointer;\"><input type=\"radio\" name=\"excl\" value=\"no\" required style=\"accent-color: #00cdfd;\" data-on=\"change:exclNo\">No</label>\n            <label style=\"display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); font-size: 15px; color: #eaf2f8; cursor: pointer;\"><input type=\"radio\" name=\"excl\" value=\"yes\" style=\"accent-color: #00cdfd;\" data-on=\"change:exclYes\">Yes</label>\n          </div>\n          <div data-if=\"exclusive\" style=\"display: contents\" hidden>\n            <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Provider and end date of that agreement *<textarea required rows=\"3\" style=\"padding: 14px 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none; resize: vertical;\" class=\"focus-wp4ty\"></textarea><span style=\"font-size: 13px; line-height: 1.5; color: #ffc46b;\">We’ll review this with you before your cards launch.</span></label>\n          </div>\n        </div>\n\n        <div style=\"display: flex; flex-direction: column; gap: 14px;\">\n          <h3 style=\"margin: 0; font-size: 18px; font-weight: 600; color: #f4fbff;\">Signed cards</h3>\n          <p style=\"margin: 0; font-size: 15px; line-height: 1.6; color: #c4d4e2;\">Are you willing to hand-sign cards for the Signed tier? We’ll mail blank cards and a prepaid return envelope.</p>\n          <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n            <label style=\"display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); font-size: 15px; color: #eaf2f8; cursor: pointer;\"><input type=\"radio\" name=\"sign\" value=\"yes\" style=\"accent-color: #00cdfd;\" data-on=\"change:signYes\">Yes</label>\n            <label style=\"display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); font-size: 15px; color: #eaf2f8; cursor: pointer;\"><input type=\"radio\" name=\"sign\" value=\"no\" style=\"accent-color: #00cdfd;\" data-on=\"change:signNo\">Not right now</label>\n          </div>\n          <div data-if=\"signing\" style=\"display: contents\" hidden>\n            <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 14px;\">\n              <label style=\"grid-column: 1 / -1; display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Mailing address *<input required autocomplete=\"street-address\" style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n              <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">City *<input required style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n              <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Postal code *<input required style=\"height: 48px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\" class=\"focus-wp4ty\"></label>\n              <label style=\"display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #9fb4c6;\">Country *\n                <select required style=\"height: 48px; padding: 0 14px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.14); background: rgba(4,28,48,0.7); color: #eaf2f8; font-family: 'Work Sans'; font-size: 15px; outline: none;\"><option value=\"\">Select</option><option value=\"AF\">Afghanistan</option><option value=\"AX\">Åland Islands</option><option value=\"AL\">Albania</option><option value=\"DZ\">Algeria</option><option value=\"AS\">American Samoa</option><option value=\"AD\">Andorra</option><option value=\"AO\">Angola</option><option value=\"AI\">Anguilla</option><option value=\"AG\">Antigua &amp; Barbuda</option><option value=\"AR\">Argentina</option><option value=\"AM\">Armenia</option><option value=\"AW\">Aruba</option><option value=\"AU\">Australia</option><option value=\"AT\">Austria</option><option value=\"AZ\">Azerbaijan</option><option value=\"BS\">Bahamas</option><option value=\"BH\">Bahrain</option><option value=\"BD\">Bangladesh</option><option value=\"BB\">Barbados</option><option value=\"BY\">Belarus</option><option value=\"BE\">Belgium</option><option value=\"BZ\">Belize</option><option value=\"BJ\">Benin</option><option value=\"BM\">Bermuda</option><option value=\"BT\">Bhutan</option><option value=\"BO\">Bolivia</option><option value=\"BA\">Bosnia &amp; Herzegovina</option><option value=\"BW\">Botswana</option><option value=\"BR\">Brazil</option><option value=\"VG\">British Virgin Islands</option><option value=\"BN\">Brunei</option><option value=\"BG\">Bulgaria</option><option value=\"BF\">Burkina Faso</option><option value=\"BI\">Burundi</option><option value=\"KH\">Cambodia</option><option value=\"CM\">Cameroon</option><option value=\"CA\">Canada</option><option value=\"CV\">Cape Verde</option><option value=\"KY\">Cayman Islands</option><option value=\"CF\">Central African Republic</option><option value=\"TD\">Chad</option><option value=\"CL\">Chile</option><option value=\"CN\">China</option><option value=\"CO\">Colombia</option><option value=\"KM\">Comoros</option><option value=\"CG\">Congo - Brazzaville</option><option value=\"CD\">Congo - Kinshasa</option><option value=\"CK\">Cook Islands</option><option value=\"CR\">Costa Rica</option><option value=\"CI\">Côte d’Ivoire</option><option value=\"HR\">Croatia</option><option value=\"CU\">Cuba</option><option value=\"CW\">Curaçao</option><option value=\"CY\">Cyprus</option><option value=\"CZ\">Czechia</option><option value=\"DK\">Denmark</option><option value=\"DJ\">Djibouti</option><option value=\"DM\">Dominica</option><option value=\"DO\">Dominican Republic</option><option value=\"EC\">Ecuador</option><option value=\"EG\">Egypt</option><option value=\"SV\">El Salvador</option><option value=\"GQ\">Equatorial Guinea</option><option value=\"ER\">Eritrea</option><option value=\"EE\">Estonia</option><option value=\"SZ\">Eswatini</option><option value=\"ET\">Ethiopia</option><option value=\"FO\">Faroe Islands</option><option value=\"FJ\">Fiji</option><option value=\"FI\">Finland</option><option value=\"FR\">France</option><o